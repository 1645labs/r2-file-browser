# Cloudflare R2 (S3-compatible API) credentials
# Create an R2 API token in the Cloudflare dashboard: R2 > Manage API Tokens.

# Account endpoint, e.g. https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=

# R2 always uses "auto"
S3_REGION=auto

# The R2 bucket to browse
S3_BUCKET=

# R2 Access Key ID / Secret Access Key from the API token
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: gate the whole app behind a shared password (leave blank for open access)
APP_PASSWORD=

# Presigned URL lifetime in seconds (download/view links)
PRESIGN_TTL=300

# Local dev port (Render sets PORT automatically)
PORT=3000
