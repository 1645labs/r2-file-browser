# Cloudflare R2 (S3-compatible API) credentials
# Create an R2 API token in the Cloudflare dashboard: R2 > Manage API Tokens.

# Account endpoint, e.g. https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=

# R2 always uses "auto"
S3_REGION=auto

# The R2 bucket to browse
S3_BUCKET=

# R2 Access Key ID / Secret Access Key from the API token
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public bucket base URL (assumes the bucket is public). Reads (thumbnails,
# image/media viewing) are served directly from here instead of via presigned
# proxy URLs. Use the R2 public dev URL or a custom domain, e.g.
#   https://pub-<hash>.r2.dev
#   https://files.example.com
# Leave blank to fall back to server-signed presigned URLs.
S3_PUBLIC_BASE_URL=

# Optional: gate the whole app behind a shared password (leave blank for open access)
APP_PASSWORD=

# Presigned URL lifetime in seconds (used only when S3_PUBLIC_BASE_URL is unset)
PRESIGN_TTL=300

# Local dev port (Render sets PORT automatically)
PORT=3000
