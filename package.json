{
  "name": "r2-file-browser",
  "version": "1.0.0",
  "description": "Simple Google-Drive-like file browser backed by Cloudflare R2 (S3-compatible API)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/lib-storage": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "busboy": "^1.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "license": "MIT"
}
